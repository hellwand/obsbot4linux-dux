{
  "id": "obsbot4linuxDux",
  "name": "OBSBOT Control",
  "description": "Bar widget and desktop preview for OBSBOT webcams, built on obsbot4linux 1.0: the controls each camera's description offers, a camera picker and a live preview",
  "version": "1.0.0",
  "author": "nofuturekid",
  "license": "GPL-3.0-or-later",
  "icon": "videocam",
  "type": "composite",
  "capabilities": [
    "dankbar-widget",
    "desktop-widget",
    "control-center",
    "process"
  ],
  "components": {
    "widget": "./ObsbotWidget.qml",
    "desktop": "./DesktopPreview.qml"
  },
  "settings": "./ObsbotSettings.qml",
  "startupCheck": "./StartupCheck.qml",
  "requires_dms": ">=2.0.0",
  "dependencies": [
    "obsbot4linux >= 1.0",
    "qt6-multimedia"
  ],
  "permissions": [
    "process",
    "settings_read",
    "settings_write"
  ]
}
